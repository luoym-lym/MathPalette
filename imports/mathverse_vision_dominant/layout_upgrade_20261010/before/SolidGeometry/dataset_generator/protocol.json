{
  "protocol_version": "1.0.0",
  "description": "MathPalette 立体几何统一重绘；三维真值、二维投影、可见性及尺寸排版分别冻结。",
  "units": {"geometry": "scene.world_unit", "stroke": "pt", "font": "pt", "label_offset": "pt", "angle": "degree"},
  "output": {"width_px": 768, "height_px": 768, "background": "#FFFFFF", "background_alpha": 1.0, "embed_question_or_answer": false, "formats": ["png", "svg"]},
  "figure": {"figsize_in": [7.68, 7.68], "dpi": 100, "axes_position": [0.08, 0.08, 0.84, 0.84], "bbox_inches": null, "pad_inches": 0.0},
  "view": {"aspect": "equal", "square_limits": true, "axes_visible": false, "grid_visible": false, "minimum_outer_margin_fraction": 0.08, "autoscale": false},
  "projection": {"supported": ["orthographic", "oblique"], "visibility_mode": "frozen_intervals", "automatic_occlusion": false},
  "font": {"family": "DejaVu Sans", "size_pt": 12, "vertex_style": "italic", "value_style": "normal", "color": "#000000", "svg_fonttype": "path"},
  "stroke": {"color": "#000000", "linewidth_pt": 1.0, "visible_linestyle": "solid", "hidden_dash_pattern_pt": [4, 3], "auxiliary_dash_pattern_pt": [4, 3], "capstyle": "round", "dash_capstyle": "butt", "antialiased": true},
  "dimension": {"linewidth_pt": 1.0, "cap_length_pt": 7, "label_rotation_deg": 0, "background_mask": false, "extension_lines_by_default": false},
  "point": {"draw_unmarked_vertices": false, "area_pt2": 36, "filled_facecolor": "#000000", "edge_linewidth_pt": 1.0},
  "fill": {"default": "none", "semantic_facecolor": "#E6E6E6", "semantic_alpha": 1.0, "decorative_lighting": false},
  "labels": {"clip_on": false, "background_mask": false},
  "validation": {"length_absolute_tolerance": 1e-8, "relative_tolerance": 1e-8, "angle_absolute_tolerance_deg": 1e-7, "projection_tolerance": 1e-10, "curve_max_chord_error_px": 0.1, "require_finite_coordinates": true, "reject_unknown_objects": true, "reject_unknown_constraints": true}
}
