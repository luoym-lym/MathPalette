{
  "protocol_version": "1.1.0",
  "description": "MathPalette 平面几何统一重绘样式；坐标只服务展示，明确几何条件优先于截图像素。",
  "units": {"length": "frozen display units", "stroke": "pt", "font": "pt", "label_offset": "pt", "angle": "degree"},
  "output": {"format": "png", "width_px": 768, "height_px": 768, "background": "#FFFFFF", "background_alpha": 1.0, "embed_question_or_answer": false, "vector_format": "svg"},
  "figure": {"figsize_in": [7.68, 7.68], "dpi": 100, "axes_position": [0.08, 0.08, 0.84, 0.84], "bbox_inches": null, "pad_inches": 0.0},
  "view": {"aspect": "equal", "square_limits": true, "axes_visible": false, "grid_visible": false, "minimum_outer_margin_fraction": 0.08, "autoscale": false},
  "font": {"family": "DejaVu Sans", "size_pt": 12, "vertex_style": "italic", "value_style": "normal", "color": "#000000", "svg_fonttype": "path"},
  "stroke": {"color": "#000000", "linewidth_pt": 1.0, "default_linestyle": "solid", "capstyle": "round", "antialiased": true, "zorder": 2},
  "auxiliary_line": {"linewidth_pt": 1.0, "dash_pattern_pt": [4, 3], "preserve_semantic_linestyle": true},
  "point": {"draw_unmarked_vertices": false, "area_pt2": 36, "filled_facecolor": "#000000", "open_facecolor": "#FFFFFF", "edgecolor": "#000000", "edge_linewidth_pt": 1.0, "zorder": 4},
  "markers": {"linewidth_pt": 1.0, "angle_arc_radius_pt": 16, "angle_label_requires_arc": true, "angle_arcs_per_angle": 1, "same_angle_labels_share_arc": true, "unlabeled_right_angle_uses_box": true, "right_angle_side_pt": 9, "tick_length_pt": 6, "tick_gap_pt": 3, "parallel_arrow_size_pt": 5},
  "labels": {"zorder": 5, "background_mask": false, "clip_on": false, "default_vertex_offset_pt": [8, 8], "default_angle_radius_pt": 27},
  "fill": {"default": "none", "semantic_facecolor": "#D0D0D0", "semantic_alpha": 0.45},
  "validation": {"angle_absolute_tolerance_deg": 1e-7, "length_absolute_tolerance": 1e-8, "relative_tolerance": 1e-8, "require_finite_coordinates": true, "reject_unknown_objects": true, "reject_unknown_constraints": true}
}
