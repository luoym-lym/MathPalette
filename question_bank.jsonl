{"source_key": "s34", "branch": "PlaneGeometry", "id": "Plane01", "source_dataset": "MathVerse", "question": "As shown in the figure, triangle ABC congruent triangle ADE, then the degree of angle EAC is ()\nChoices:\nA:40°\nB:45°\nC:35°\nD:25°", "answer": "B", "source_answer": "B", "image": "PlaneGeometry/image/Plane01.png", "original_image": "PlaneGeometry/originals/Plane01.png", "script": "PlaneGeometry/dataset_generator/plane_plot01.py", "verification": "PlaneGeometry/dataset_generator/scenes/Plane01.json", "report": "PlaneGeometry/dataset_generator/reports/Plane01_redraw_report.json", "image_sha256": "9dd67c354f6c57d836419a7b74177e483595bd7ade8bc3e246b84c0aaa68ba00", "status": "verified", "answer_verification": {"status": "verified", "verified_answer": "B", "issue": "", "reasoning": "Triangle ABC has angles A=80, B=70, C=30. Congruence ABC=ADE gives angle DAE=80. Ray AC is 35 degrees from AD, so angle EAC=45 degrees, choice B."}, "retained": true, "user_pass": true, "registration_status": "registered", "user_review": {"status": "registered", "user_pass": true, "reviewer": "user", "approved_at_utc": "2026-10-09T17:45:26.023620+00:00", "content_sha256": "e9ef3d27801345a6c632d39c8b0b3f6c883675c072f767b7165b8ac17cb67c28", "approved_content_sha256": "e9ef3d27801345a6c632d39c8b0b3f6c883675c072f767b7165b8ac17cb67c28"}}
{"source_key": "s209", "branch": "PlaneGeometry", "id": "Plane02", "source_dataset": "MathVerse", "question": "It is known that BC parallel PQ, AB:AP = 2.0:5.0, then the length of CQ is ()\nChoices:\nA:8cm\nB:12cm\nC:30cm\nD:50cm", "answer": "B", "source_answer": "B", "image": "PlaneGeometry/image/Plane02.png", "original_image": "PlaneGeometry/originals/Plane02.png", "script": "PlaneGeometry/dataset_generator/plane_plot02.py", "verification": "PlaneGeometry/dataset_generator/scenes/Plane02.json", "report": "PlaneGeometry/dataset_generator/reports/Plane02_redraw_report.json", "image_sha256": "dfa1d71fe8ad336d3fb294ea83a3792d3af70037faadc27f6219c2e077ea8978", "status": "verified", "answer_verification": {"status": "verified", "verified_answer": "B", "issue": "", "reasoning": "AQ=20 and similar triangles give AC/AQ=AB/AP=2/5. Therefore AC=8 and CQ=12 cm, choice B."}, "retained": true, "user_pass": true, "registration_status": "registered", "user_review": {"status": "registered", "user_pass": true, "reviewer": "user", "approved_at_utc": "2026-10-09T17:51:56.001341+00:00", "content_sha256": "606bcd53bae1fc0807e8d4a88ecdb6109512f516c32c004dc021f0d46fede48b", "approved_content_sha256": "606bcd53bae1fc0807e8d4a88ecdb6109512f516c32c004dc021f0d46fede48b"}}
