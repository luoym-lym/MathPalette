    "content": "\"\"\"Frozen native MathVision redraw; importing does not write files.\"\"\"\nfrom pathlib import Path\nimport importlib.util\nimport json\nHERE = Path(__file__).resolve().parent\n\nclass Plane484:\n\n    def __init__(self):\n        self.__dict__.update({'id': 'Plane484', 'source_dataset': 'MathVision', 'question': 'Two rays with a common endpoint A0 form an angle of $1^o$. Construct a sequence of points $A_0$, $. . . $, $A_n$ such that for all $1 \\\\le i \\\\le n$, $|A_{i-1}A_i | = 1$, and $|A_iA_0| > |A_{i-1}A_0|$. Find the largest possible value of $n$.', 'answer': '90', 'answer_type': 'number', 'subject': 'PlaneGeometry', 'source_key': 'test:2835', 'source_category': 'transformation geometry', 'source_revision': '2837ddb3f13abaf6b3997c12d80753e5470bd46a'})\n        self.query = self.question\n        self.level = None\n        self.scene_path = HERE / 'scenes/Plane484.json'\n\n    def get_scene(self):\n        return json.loads(self.scene_path.read_text(encoding='utf-8'))\n\n    def draw(self, num=0, output_path=None):\n        if output_path is None and isinstance(num, (str, Path)):\n            output_path = num\n        output = Path(output_path) if output_path else HERE.parents[1] / '.runtime/mathvision_redraw' / 'Plane484.png'\n        spec = importlib.util.spec_from_file_location('mathvision_native_runtime', HERE / 'mathvision_renderers/shared_e4e003f51742cf00/runtime.py')\n        runtime = importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(runtime)\n        return runtime.draw(HERE / 'mathvision_renderers/shared_e4e003f51742cf00/items/Plane484', HERE / 'mathvision_renderers/shared_e4e003f51742cf00/native', output, formal_scene=self.scene_path, original_image=HERE / '../originals/Plane484.jpg')\n\n    def redraw(self, output_path=None):\n        return self.draw(output_path=output_path)\nif __name__ == '__main__':\n    import sys\n    print(Plane484().draw(output_path=sys.argv[1] if len(sys.argv) > 1 else None))\n"
