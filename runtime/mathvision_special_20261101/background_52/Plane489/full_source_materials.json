    "content": "\"\"\"Frozen native MathVision redraw; importing does not write files.\"\"\"\nfrom pathlib import Path\nimport importlib.util\nimport json\nHERE = Path(__file__).resolve().parent\n\nclass Plane489:\n\n    def __init__(self):\n        self.__dict__.update({'id': 'Plane489', 'source_dataset': 'MathVision', 'question': \"A solid $5\\\\times 5\\\\times 5$ cube is composed of unit cubes. Each face of the large, solid cube is partially painted with gray paint, as shown. What fraction of the entire solid cube's unit cubes have no paint on them?\", 'answer': '\\\\frac{69}{125}', 'answer_type': 'number', 'subject': 'PlaneGeometry', 'source_key': 'test:2919', 'source_category': 'combinatorial geometry', 'source_revision': '2837ddb3f13abaf6b3997c12d80753e5470bd46a'})\n        self.query = self.question\n        self.level = None\n        self.scene_path = HERE / 'scenes/Plane489.json'\n\n    def get_scene(self):\n        return json.loads(self.scene_path.read_text(encoding='utf-8'))\n\n    def draw(self, num=0, output_path=None):\n        if output_path is None and isinstance(num, (str, Path)):\n            output_path = num\n        output = Path(output_path) if output_path else HERE.parents[1] / '.runtime/mathvision_redraw' / 'Plane489.png'\n        spec = importlib.util.spec_from_file_location('mathvision_native_runtime', HERE / 'mathvision_renderers/shared_e4e003f51742cf00/runtime.py')\n        runtime = importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(runtime)\n        return runtime.draw(HERE / 'mathvision_renderers/shared_e4e003f51742cf00/items/Plane489', HERE / 'mathvision_renderers/shared_e4e003f51742cf00/native', output, formal_scene=self.scene_path, original_image=HERE / '../originals/Plane489.jpg')\n\n    def redraw(self, output_path=None):\n        return self.draw(output_path=output_path)\nif __name__ == '__main__':\n    import sys\n    print(Plane489().draw(output_path=sys.argv[1] if len(sys.argv) > 1 else None))\n"
