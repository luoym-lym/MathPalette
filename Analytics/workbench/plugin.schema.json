{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mathpalette:C:1.0.0",
  "title": "MathPalette C declarative plugin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin_schema_version",
    "question_id",
    "category",
    "operation",
    "params"
  ],
  "properties": {
    "plugin_schema_version": {
      "const": "1.0.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^Ana(0[1-9]|[1-9][0-9]+)$"
    },
    "category": {
      "const": "C"
    },
    "operation": {
      "const": "C_manual"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "intent": {
      "type": "string",
      "maxLength": 1000
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/add_point"
              },
              {
                "$ref": "#/$defs/add_line"
              },
              {
                "$ref": "#/$defs/set_curve_style"
              },
              {
                "$ref": "#/$defs/add_text"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "number": {
      "type": "number"
    },
    "xy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/number"
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "linewidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "linestyle": {
      "enum": [
        "solid",
        "dashed"
      ]
    },
    "add_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "xy"
      ],
      "properties": {
        "type": {
          "const": "add_point"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "xy": {
          "$ref": "#/$defs/xy"
        },
        "filled": {
          "type": "boolean"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "size_pt2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2500
        },
        "edge_linewidth_pt": {
          "$ref": "#/$defs/linewidth"
        }
      }
    },
    "add_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "endpoints"
      ],
      "properties": {
        "type": {
          "const": "add_line"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/xy"
          }
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "linestyle": {
          "$ref": "#/$defs/linestyle"
        },
        "linewidth_pt": {
          "$ref": "#/$defs/linewidth"
        },
        "dash_pattern_pt": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "set_curve_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "const": "set_curve_style"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "linestyle": {
          "$ref": "#/$defs/linestyle"
        },
        "linewidth_pt": {
          "$ref": "#/$defs/linewidth"
        }
      }
    },
    "add_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "xy",
        "text"
      ],
      "properties": {
        "type": {
          "const": "add_text"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "xy": {
          "$ref": "#/$defs/xy"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "fontsize_pt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 96
        },
        "ha": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "va": {
          "enum": [
            "top",
            "center",
            "bottom",
            "baseline",
            "center_baseline"
          ]
        }
      }
    }
  }
}
