{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mathpalette:SolidGeometry:C:1.0.0",
  "title": "MathPalette SolidGeometry Special annotation plugin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin_schema_version",
    "question_id",
    "category",
    "operation",
    "params"
  ],
  "properties": {
    "plugin_schema_version": {
      "const": "1.0.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^Solid(0[1-9]|[1-9][0-9]+)$"
    },
    "category": {
      "const": "C"
    },
    "operation": {
      "const": "C_manual"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "intent": {
      "type": "string",
      "maxLength": 1000
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/add_point"
              },
              {
                "$ref": "#/$defs/add_line"
              },
              {
                "$ref": "#/$defs/set_object_style"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "number": {
      "type": "number"
    },
    "xy": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/number"
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "#DC2626",
        "#2563EB",
        "#16A34A",
        "#EA580C"
      ]
    },
    "linewidth": {
      "type": "number",
      "enum": [
        1.0
      ]
    },
    "linestyle": {
      "enum": [
        "solid",
        "dashed"
      ]
    },
    "add_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "xy"
      ],
      "properties": {
        "type": {
          "const": "add_point"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "xy": {
          "$ref": "#/$defs/xy"
        },
        "filled": {
          "const": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "size_pt2": {
          "type": "number",
          "enum": [
            50
          ]
        },
        "edge_linewidth_pt": {
          "$ref": "#/$defs/linewidth"
        }
      }
    },
    "add_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "endpoints"
      ],
      "properties": {
        "type": {
          "const": "add_line"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/xy"
          }
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "linestyle": {
          "$ref": "#/$defs/linestyle"
        },
        "linewidth_pt": {
          "$ref": "#/$defs/linewidth"
        },
        "dash_pattern_pt": {
          "const": [
            3.7,
            1.6
          ]
        }
      }
    },
    "set_object_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "const": "set_object_style"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "color": {
          "$ref": "#/$defs/object_color"
        },
        "linestyle": {
          "$ref": "#/$defs/linestyle"
        },
        "linewidth_pt": {
          "type": "number",
          "enum": [
            0.5,
            1,
            1.5,
            2,
            3
          ]
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path_id",
            "path_sha256",
            "start",
            "end",
            "wrap"
          ],
          "properties": {
            "path_id": {
              "type": "string",
              "pattern": "^p[0-9]+$"
            },
            "path_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wrap": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "object_color": {
      "type": "string",
      "enum": [
        "#DC2626",
        "#2563EB",
        "#16A34A",
        "#EA580C",
        "#000000"
      ]
    }
  }
}
